{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "discord.js": ["node_modules/discord.js"],
      "discord.js/*": ["node_modules/discord.js/*"]
    },
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../dis-bot-assets-private/commands/**/*.ts",
    "../dis-bot-assets-private/config/**/*.ts",
    "../dis-bot-assets-private/utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "logs"
  ]
}
