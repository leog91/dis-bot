{
  "name": "dis-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare-logs": "mkdir -p logs",
    "dev": "bun --watch index.ts",
    "dev-logging": "bun run prepare-logs && bun run dev >> logs/log-$(date +%Y-%m-%d).txt 2>&1",
    "dev-logging-watch": "bun run dev-logging & tail -f logs/log-$(date +%Y-%m-%d).txt",
    "sync-private-assets": "bash scripts/sync-private-assets.sh",
    "db:migrate": "bunx drizzle-kit migrate",
    "typecheck": "bunx --bun tsc -p tsconfig.private.json",
    "typecheck:private": "bunx --bun tsc -p tsconfig.private.json",
    "start": "node index.js",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.19.2",
    "@snazzah/davey": "^0.1.11",
    "chalk": "^5.6.2",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "google-tts-api": "^2.0.2",
    "libsodium-wrappers": "^0.7.16",
    "lowdb": "^7.0.1",
    "node-fetch": "^3.3.2",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.18",
    "@types/bun": "^1.3.13",
    "better-sqlite3": "^12.9.0",
    "drizzle-kit": "^0.31.10",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  }
}
