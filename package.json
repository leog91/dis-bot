{
  "name": "dis-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare-logs": "mkdir -p logs",
    "dev": "bun --watch index.ts",
    "dev-logging": "bun run prepare-logs && bun run dev >> logs/log-$(date +%Y-%m-%d).txt 2>&1",
    "dev-logging-watch": "bun run dev-logging & tail -f logs/log-$(date +%Y-%m-%d).txt",
    "sync-private-assets": "bash scripts/sync-private-assets.sh",
    "db:migrate": "bunx drizzle-kit migrate",
    "typecheck:private": "bunx tsc -p tsconfig.private.json",
    "start": "node index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.7",
    "chalk": "^5.6.2",
    "discord.js": "^14.24.2",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "google-tts-api": "^2.0.2",
    "libsodium-wrappers": "^0.7.15",
    "lowdb": "^7.0.1",
    "node-fetch": "^3.3.2",
    "opusscript": "^0.1.1",
    "prism-media": "^1.3.5",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/bun": "^1.3.6",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.8",
    "nodemon": "^3.1.7",
    "typescript": "^5.7.3"
  }
}
